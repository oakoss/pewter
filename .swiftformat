--swiftversion 6.0
--indent 4
--maxwidth 120
--wraparguments before-first
--wrapcollections before-first
--stripunusedargs closure-only
--self remove
--header strip
# tools/ holds standalone scripts, not build-target sources. Excluded because
# `--header strip` treats their leading usage block as a file header and
# deletes it — the documentation is the point of a dev tool.
--exclude build,Pewter.xcodeproj,Core/.build,tools
